# Copy to .env.local for local development. Leave the Firebase values empty to run the
# site without accounts; the website then uses its built-in content.
#
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# These identify the project and are safe to publish; access is enforced by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local testing without a real project: run `npm run emulators`, then use
#   VITE_FIREBASE_API_KEY=demo-key
#   VITE_FIREBASE_AUTH_DOMAIN=localhost
#   VITE_FIREBASE_PROJECT_ID=demo-gfc
#   VITE_FIREBASE_APP_ID=demo-app
#   VITE_FIREBASE_EMULATORS=true
VITE_FIREBASE_EMULATORS=
