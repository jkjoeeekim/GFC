{
  "name": "gfc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src vite.config.ts",
    "preview": "vite preview",
    "check:content": "node --experimental-strip-types scripts/check-content.mjs",
    "emulators": "npx -y firebase-tools@15.37.0 emulators:start --project demo-gfc",
    "test:rules": "npx -y firebase-tools@15.37.0 emulators:exec --only firestore --project demo-gfc 'node --experimental-strip-types --test tests/firestore.rules.test.mjs'",
    "deploy:rules": "npx -y firebase-tools@15.37.0 deploy --only firestore:rules"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "firebase": "^13.4.0",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.0",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
